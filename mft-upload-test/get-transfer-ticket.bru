meta {
  name: Get Transfer Ticket (Bearer)
  type: http
  seq: 1
}

post {
  url: {{api_endpoint}}/transfer-tickets
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{entra_access_token}}
}

body:json {
  {
    "clientId": "products-poc",
    "fileName": "example-upload.csv",
    "contentType": "text/csv",
    "sizeBytes": 20
  }
}

script:pre-request {
  bru.deleteVar("upload_url");
  bru.deleteVar("upload_headers");
}

script:post-response {
  const ticket = res.getBody();
  if (![200, 201].includes(res.getStatus()) || !ticket.upload || ticket.upload.method !== "PUT") {
    throw new Error("No single-file upload ticket returned. Check authentication and file metadata before uploading.");
  }
  bru.setVar("upload_url", ticket.upload.url);
  bru.setVar("upload_headers", ticket.upload.headers);
  bru.setVar("transfer_ticket", ticket.transferTicket);
  bru.setVar("upload_bucket", ticket.object.bucket);
  bru.setVar("upload_key", ticket.object.key);
}
