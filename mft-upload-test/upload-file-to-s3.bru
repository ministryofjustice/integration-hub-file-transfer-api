meta {
  name: Upload File To S3
  type: http
  seq: 2
}

put {
  url: {{upload_url}}
  body: file
  auth: none
}

body:file {
  file: @file()
}

script:pre-request {
  const url = bru.getVar("upload_url");
  const headers = bru.getVar("upload_headers");
  if (!url || !headers) {
    throw new Error("Run Get Transfer Ticket successfully before uploading.");
  }
  req.deleteHeader("Authorization");
  Object.entries(headers).forEach(([name, value]) => req.setHeader(name, value));
}
