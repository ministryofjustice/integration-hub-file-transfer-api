meta {
  name: Create Multipart Upload
  type: http
  seq: 4
}

post {
  url: {{api_endpoint}}/transfer-tickets
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{entra_access_token}}
}

body:json {
  {
    "clientId": "products-poc",
    "fileName": "sample_6gb.dat",
    "contentType": "application/octet-stream",
    "sizeBytes": 6442450944,
    "requestedExpirySeconds": 3600
  }
}

script:pre-request {
  bru.deleteVar("multipart_part_urls");
  bru.deleteVar("multipart_uploaded_parts");
  bru.deleteVar("part_1_url");
  bru.deleteVar("multipart_total_parts");
}

script:post-response {
  const ticket = res.getBody();
  if (res.getStatus() !== 200 || !ticket.multipart) {
    throw new Error("No multipart upload ticket returned.");
  }
  bru.setVar("multipart_uploaded_parts", []);
  bru.setVar("multipart_total_parts", ticket.multipart.totalParts);
  const source = req.getBody();
  bru.setVar("multipart_declared_size", source.sizeBytes);
  bru.setVar("multipart_source_name", source.fileName);
  const urls = {};
  ticket.multipart.initialParts.forEach(part => { urls[part.partNumber] = part.url; });
  bru.setVar("multipart_part_urls", urls);
  bru.setVar("multipart_part_number", 1);
  const firstPart = ticket["multipart"]["initialParts"][0];

  bru.setVar("transfer_ticket", ticket["transferTicket"]);
  bru.setVar("multipart_upload_id", ticket["multipart"]["uploadId"]);
  bru.setVar("part_size_bytes", ticket["multipart"]["partSizeBytes"]);
  bru.setVar("upload_bucket", ticket["object"]["bucket"]);
  bru.setVar("upload_key", ticket["object"]["key"]);
  bru.setVar("part_1_url", firstPart["url"]);
}
