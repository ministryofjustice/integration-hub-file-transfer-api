meta {
  name: Presign Multipart Part URLs
  type: http
  seq: 5
}

post {
  url: {{api_endpoint}}/transfer-tickets/{{transfer_ticket}}/parts
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{entra_access_token}}
}

body:json {
  {
    "partNumberStart": 2,
    "partNumberEnd": 3
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() !== 200 || !Array.isArray(body.parts)) {
    throw new Error("No multipart part URLs returned.");
  }
  const urls = bru.getVar("multipart_part_urls") || {};
  body.parts.forEach(part => { urls[part.partNumber] = part.url; });
  bru.setVar("multipart_part_urls", urls);
}
