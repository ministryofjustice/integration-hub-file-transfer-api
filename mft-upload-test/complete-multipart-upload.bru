meta {
  name: Complete Multipart Upload
  type: http
  seq: 7
}

post {
  url: {{api_endpoint}}/transfer-tickets/{{transfer_ticket}}/complete
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{entra_access_token}}
}

body:json {
  {"parts": []}
}

script:pre-request {
  const parts = bru.getVar("multipart_uploaded_parts") || [];
  if (!parts.length) {
    throw new Error("Upload each part to S3 first. Completion needs S3's returned ETags.");
  }
  const ordered = [...parts].sort((a, b) => a.partNumber - b.partNumber);
  const expected = Number(bru.getVar("multipart_total_parts"));
  if (expected && (ordered.length !== expected || ordered.some((part, index) => part.partNumber !== index + 1))) {
    throw new Error("Some parts have not uploaded successfully. Upload every part before completion.");
  }
  req.setBody({parts: ordered});
}
